# =====================================================================
# 明哥中港牌 Agent - 环境变量示例
# 复制为 .env 后按需填写。所有 key 留空 = 该渠道自动跳过。
# =====================================================================

# ---- 鉴权（必填，否则服务拒绝启动）----
# 简易邀请码。前端首次访问会要求输入。
INVITE_CODE=REPLACE_ME_INVITE_CODE
# 仅本机开发时用 true 关闭鉴权。公网部署绝不要设 true。
AUTH_DISABLED=false

# ---- LLM（两种接入方式，二选一）----
# 方式 A：DeepSeek 官方 API
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   DEEPSEEK_API_KEY=sk-...
#   DEEPSEEK_MODEL=deepseek-flash
#
# 方式 B：OpenCode Go 订阅网关（$10/月，含 DeepSeek V4.1 Flash）
#   端点：https://opencode.ai/zen/go/v1
#   模型 ID：deepseek-v4.1-flash（另有 deepseek-v4-pro / deepseek-v4-flash）
#   key 以 oc_sk_ 开头。网关要求客户端带自有 User-Agent 与 x-opencode-session，
#   所以必须设 OPENCODE_GO=true（代码会自动补这两个 header）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENCODE_GO=false

# ---- 软评分评审模型（可选）----
# 质检管线（软评分 + 反思改写）默认用同一模型。想加强「评审器与生成器解耦」
# （方案 §6.2-E），可指定另一模型做评审，例如 deepseek-v4-pro。
# 留空 = 与 DEEPSEEK_MODEL 相同。
SCORER_MODEL=

# ---- 候选池大小（可选）----
# Best-of-N：内部生成 N 版（每角度×2语气候选），质检后每角度留最优 1 版展示。
# 默认 6（3角度×2语气）；想省时延可设 3（回到无筛选模式）。
GENERATE_CANDIDATES=6

# ---- 情报推送（外部搜索 Agent 用，推荐主路径）----
# 外部 Agent 每天搜完 POST 到 /api/intel/push 时携带此 token。
# 留空则推送接口返回 503（未启用）。
INTEL_PUSH_TOKEN=

# ---- 搜索渠道（本地兜底 / 手动检索用，非必需）----
# 注意：Tavily 无 keyless 模式，必须填 key；Firecrawl 支持免 key。
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# SearXNG 自建实例 URL
SEARXNG_INSTANCE_URL=
EXA_API_KEY=
DIFFBOT_API_KEY=
BRAVE_API_KEY=

# ---- 应用 ----
PORT=3000
DATA_DIR=./data

# ---- 本地兜底抓取的 Cron（仅当 INTEL_ENABLED=true 时生效）----
# 主路径建议用外部 Agent 推送，此项仅作备份
INTEL_ENABLED=false
INTEL_CRON=0 8 * * 1
