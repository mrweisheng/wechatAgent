# =====================================================================
# 明哥中港牌 Agent - 环境变量示例
# 复制为 .env 后按需填写。所有 key 留空 = 该渠道自动跳过。
# =====================================================================

# ---- LLM（两种接入方式，二选一）----
# 方式 A：DeepSeek 官方 API
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   DEEPSEEK_API_KEY=sk-...
#   DEEPSEEK_MODEL=deepseek-flash
#
# 方式 B：OpenCode Go 订阅网关（$10/月，含 DeepSeek V4.1 Flash）
#   端点：https://opencode.ai/zen/go（代码会再拼 /v1/chat/completions）
#   模型 ID：deepseek-v4.1-flash（另有 deepseek-v4-pro / deepseek-v4-flash）
#   key 以 oc_sk_ 开头。网关要求客户端带自有 User-Agent 与 x-opencode-session，
#   所以必须设 OPENCODE_GO=true（代码会自动补这两个 header）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENCODE_GO=false

# ---- 软评分评审模型（可选）----
# 质检管线（软评分 + 反思改写）默认用同一模型。想加强「评审器与生成器解耦」
# （方案 §6.2-E），可指定另一模型做评审，例如 deepseek-v4-pro。
# 留空 = 与 DEEPSEEK_MODEL 相同。
SCORER_MODEL=

# ---- 候选池大小（可选，2026-10-06 两段式重构后口径）----
# 生成是两段式：先出 1 版母版（创作温度），再对母版做 N-1 版机械轻微改写（低温度）。
# 默认 6 = 1 母版 + 5 改写候选，质检后取最优 3 版展示；设 3 = 关闭筛选。
GENERATE_CANDIDATES=6

# ---- 生成接口限流（可选，2026-10-06）----
# /api/generate 按 IP 限流（内存实现，重启清零）。默认 30 次/小时。
#GENERATE_RATE_LIMIT=30

# ---- 推理开关（2026-10-05；2026-10-06 起仅网关模式注入 reasoning_effort）----
# 该网关模型为推理模型，思考 token 与正文共用 max_tokens，曾把正文挤空（实测解析出 0 版）。
# off = 关闭思考（实测提速约 4x、输出 token 降约 90%，推荐）
# on  = 恢复推理（同一网关下 reasoning_effort 仅 'none' 生效，'low' 会被忽略）
# 注：reasoning_effort='none' 是 OpenCode Go 网关扩展参数，DeepSeek 官方 API 未验证
# 支持——官方通道（OPENCODE_GO=false）不注入该参数，LLM_REASONING 对官方通道无效果。
LLM_REASONING=off

# ---- LLM 调用留痕（可观测性，2026-10-05）----
# on  = 每次调用写一行 <DATA_DIR>/llm-trace.jsonl；空正文/截断另存 <DATA_DIR>/llm-fail/
# off = 关闭（测试用）
LLM_TRACE=on

# ---- 去重阈值（2026-10-05）----
# 微信折叠只在「完全相同」时发生，稍有不同即无影响；默认 0.9 = 只拦几乎一模一样。
# 调小更严格（更易触发重写）；取值 0-1。
# SIM_REWRITE_THRESHOLD：新文案与历史/样本相似度 ≥ 此值才触发重写
# SIM_MUTUAL_MAX：同批三版两两相似度 ≥ 此值才判重（0.99 = 只拦复制粘贴级）
SIM_REWRITE_THRESHOLD=0.9
SIM_MUTUAL_MAX=0.99

# ---- 改写结构护栏（2026-10-06 审计新增）----
# SIM_BASE_MIN：阶段二改写稿与母版的最小相似度，低于此值视为改写失控不收（默认 0.6）
# SIM_LIGHT_MIN：仅低分触发的反思重写稿，与原稿相似度低于此值弃用保三版结构（默认 0.45）
#SIM_BASE_MIN=0.6
#SIM_LIGHT_MIN=0.45

# ---- 情报推送（外部搜索 Agent 用，推荐主路径）----
# 外部 Agent 每天搜完 POST 到 /api/intel/push 时携带此 token。
# 留空则推送接口返回 503（未启用）。
INTEL_PUSH_TOKEN=

# ---- 搜索渠道（本地兜底 / 手动检索用，非必需）----
# 注意：Tavily 无 keyless 模式，必须填 key；Firecrawl 支持免 key。
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# SearXNG 自建实例 URL
SEARXNG_INSTANCE_URL=
EXA_API_KEY=
DIFFBOT_API_KEY=
BRAVE_API_KEY=

# ---- 应用 ----
PORT=3000
DATA_DIR=./data

# ---- 本地兜底抓取的 Cron（仅当 INTEL_ENABLED=true 时生效）----
# 主路径建议用外部 Agent 推送，此项仅作备份
# INTEL_CRON 按 INTEL_TZ 时区触发（2026-10-06 起显式带时区，UTC 服务器不再偏 8 小时）
INTEL_ENABLED=false
INTEL_CRON=0 8 * * 1
#INTEL_TZ=Asia/Hong_Kong
